%%% matrix styless 
% underline
\def\@shortul#1{\mkern1mu\underline{\mkern-1mu#1\mkern-1mu}\mkern1mu}
\def\@colmatul#1{\@shortul{#1}}
\def\@matul#1{\@shortul{\@shortul{#1}}}
% brackets
\def\@colmatbr#1{\{#1\}}
\def\@matbr#1{[#1]}
% boldface
\def\@colmatbf#1{\pmb{#1}}
\def\@matbf#1{\pmb{#1}}
% typsetting commands
\newif\if@ul
\def\@mechvar{\if@stressfree\stress\fi\if@strainfree\strain\fi}
\def\@elvar{\if@efieldfree\efield\fi\if@dfieldfree\dfield\fi}
\def\@thermvar{\if@temperaturefree\temperature\fi\if@entropydensityfree\entropydensity\fi}
\newcount\@argc
\def\@doublesuper#1#2#3{%
  \@argc 2\relax
  \@ifempty{#2}
    \advance\@argc -1\relax
  \fi
  \@ifempty{#3}
    \advance\@argc -1\relax
  \fi
  \ifcase\@argc\relax
    #1\or
    #1^{\@ulfalse#2#3}\or
    #1^{\@ulfalse#2,#3}
  \fi 
}
\def\@matsuperext#1#2#3{%
  \@argc 2\relax
  \@ifempty{#2}
    \advance\@argc -1\relax
  \fi
  \@ifempty{#3}
    \advance\@argc -1\relax
  \fi
  \if@ul
    \edef\temp{\mat{#1}}
  \else
    \edef\temp{#1}
  \fi
  \ifcase\@argc\relax
    \temp\or
    {\temp}^{\@ulfalse#2#3}\or
    {\temp}^{\@ulfalse#2,#3}\relax
  \fi 
}
\def\@matsuperint#1#2#3{%
  \@argc 2\relax
  \@ifempty{#2}
    \advance\@argc -1\relax
  \fi
  \@ifempty{#3}
    \advance\@argc -1\relax
  \fi
  \if@ul
    \ifcase\@argc\relax
      \mat{#1}\or
      \mat{#1^{\@ulfalse#2#3}}\or
      \mat{#1^{\@ulfalse#2,#3}}
    \fi 
  \else
      \ifcase\@argc\relax
        #1\or
        #1^{\@ulfalse#2#3}\or
        #1^{\@ulfalse#2,#3}
      \fi 
  \fi
}
%%
\def\@colsuperext#1#2#3{%
  \@argc 2\relax
  \@ifempty{#2}
    \advance\@argc -1\relax
  \fi
  \@ifempty{#3}
    \advance\@argc -1\relax
  \fi
  \if@ul
    \edef\temp{\colmat{#1}}
  \else
    \edef\temp{#1}
  \fi
  \ifcase\@argc\relax
    \temp\or
    {\temp}^{\@ulfalse#2#3}\or
    {\temp}^{\@ulfalse#2,#3}\relax
  \fi 
}
\def\@colsuperint#1#2#3{%
  \@argc 2\relax
  \@ifempty{#2}
    \advance\@argc -1\relax
  \fi
  \@ifempty{#3}
    \advance\@argc -1\relax
  \fi
  \if@ul
    \ifcase\@argc\relax
      \colmat{#1}\or
      \colmat{#1^{\@ulfalse#2#3}}\or
      \colmat{#1^{\@ulfalse#2,#3}}
    \fi 
  \else
      \ifcase\@argc\relax
        #1\or
        #1^{\@ulfalse#2#3}\or
        #1^{\@ulfalse#2,#3}
      \fi 
  \fi
}
\def\@matpext#1{{\mat{#1}'}}
\def\@matpint#1{{\mat{#1'}}}
\def\@colmatpext#1{{\colmat{#1}'}}
\def\@colmatpint#1{{\colmat{#1'}}}
%%% end - matrix styles

%%% matrix style-setting commands
\def\underlinemat{%
  \let\mat\@matul
  \let\colmat\@colmatul
  \let\matp\@matpext
  \let\colmatp\@colmatpext
  \@matrixtype\@underlinematrixtype\relax
  \let\@matsuper\@matsuperext
  \let\@colsuper\@colsuperext
}
\def\bracketmat{%
  \let\mat\@matbr
  \let\colmat\@colmatbr
  \let\matp\@matpint
  \let\colmatp\@colmatpint
  \@matrixtype\@bracketmatrixtype\relax
  \let\@matsuper\@matsuperint
  \let\@colsuper\@colsuperint
}
\def\boldfacemat{%
  \let\mat\@matbf
  \let\colmat\@colmatbf
  \let\matp\@matpext
  \let\colmatp\@colmatpext
  \@matrixtype\@boldmatrixtype\relax
  \let\@matsuper\@matsuperext
  \let\@colsuper\@colsuperext
}
\ifcase\@matrixtype\relax\underlinemat\or\boldfacemat\or\bracketmat\fi 
%%% end --- matrix style-setting commands

