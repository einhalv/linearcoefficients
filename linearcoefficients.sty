%%% matrix styles
% underline
\def\@shortul#1{\mkern1mu\underline{\mkern-1mu#1\mkern-1mu}\mkern1mu}
\def\@colmatul#1{\@shortul{#1}}
\def\@matul#1{\@shortul{\@shortul{#1}}}
% brackets
\def\@colmatbr#1{\{#1\}}
\def\@matbr#1{[#1]}
% boldface
\def\@colmatbf#1{\pmb{#1}}
\def\@matbf#1{\boldsymbol{#1}}
% style-setting commands
\def\@matpext#1{{\mat{#1}'}}
\def\@matpint#1{{\mat{#1'}}}
\def\@colmatpext#1{{\colmat{#1}'}}
\def\@colmatpint#1{{\colmat{#1'}}}
\def\underlinemat{%
  \let\mat\@matul
  \let\colmat\@colmatul
  \let\matp\@matpext
  \let\colmatp\@colmatpext
}
\def\bracketmat{%
  \let\mat\@matbr
  \let\colmat\@colmatbr
  \let\matp\@matpint
  \let\colmatp\@colmatpint
}
\def\boldfacemat{%
  \let\mat\@matbf
  \let\colmat\@colmatbf
  \let\matp\@matpext
  \let\colmatp\@colmatpext
}
\boldfacemat

