% full commands
\newif\if@ul
\def\@mechvar{\if@stressfree\stress\fi\if@strainfree\strain\fi}
\def\@elvar{\if@efieldfree\efield\fi\if@dfieldfree\dfield\fi}
\def\@thermvar{\if@temperaturefree\temperature\fi\if@entropydensityfree\entropydensity\fi}
\newcount\@argc
\def\@doublesuper#1#2#3{%
  \@argc 2\relax
  \@ifempty{#2}
    \advance\@argc -1\relax
  \fi
  \@ifempty{#3}
    \advance\@argc -1\relax
  \fi
  \ifcase\@argc\relax
    #1\or
    #1^{\@ulfalse#2#3}\or
    #1^{\@ulfalse#2,#3}
  \fi 
}
\def\@singlesuper#1#2{%
  \@argc 1\relax
  \@ifempty{#2}
    \advance\@argc -1\relax
  \fi
  \ifcase\@argc\relax
    #1\or
    #1^{\@ulfalse#2}
  \fi 
}
\newcommand{\umat}[1]{\@ultrue#1\@ulfalse}
\newcommand{\@usymbol}[1]{\if@ul\colmat{#1}\else#1\fi}
\newcommand{\@uusymbol}[1]{\if@ul\mat{{#1}}\else{#1}\fi}

\newcommand{\polarization}{\@usymbol{\polarizationsymbol}}
